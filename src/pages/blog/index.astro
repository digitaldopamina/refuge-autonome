---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  preparation: 'Préparation',
  equipement: 'Équipement',
  habitat: 'Habitat',
  sante: 'Santé',
  securite: 'Sécurité',
};
---
<BaseLayout title="Tous les guides" description="L'ensemble de nos guides pratiques pour préparer votre famille aux imprévus.">
  <Header />
  <main>
    <section class="page-header">
      <div class="container">
        <p class="label">Bibliothèque</p>
        <h1>Tous les guides</h1>
        <p class="page-desc">{sorted.length} guides pratiques pour votre autonomie</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="grid-3">
          {sorted.map(article => (
            <a href={`/blog/${article.id}`} class="article-card">
              <div class="article-card__image-placeholder">
                {article.data.category === 'preparation' ? '🎒' :
                 article.data.category === 'equipement' ? '⚡' :
                 article.data.category === 'habitat' ? '🏡' :
                 article.data.category === 'sante' ? '🩹' : '🔒'}
              </div>
              <div class="article-card__body">
                <span class={`category-badge category-badge--${article.data.category}`}>
                  {categoryLabels[article.data.category]}
                </span>
                <h3 class="article-card__title">{article.data.title}</h3>
                <p class="article-card__excerpt">{article.data.description}</p>
                <div class="article-card__meta">
                  <span>{article.data.pubDate.toLocaleDateString('fr-FR', {day:'numeric',month:'short',year:'numeric'})}</span>
                  {article.data.readingTime && <span>{article.data.readingTime} min</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--border-subtle); }
.page-header h1 { font-size: 2.5rem; margin: 0.5rem 0; }
.page-desc { color: var(--text-secondary); }
.section { padding: 3rem 0 5rem; }
</style>
