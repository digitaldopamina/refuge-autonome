---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">Le Refuge Autonome</a>
      <p>Préparer sa famille aux imprévus,<br/>avec calme et méthode.</p>
      <div class="footer-social">
        <a href="https://www.youtube.com/@refugeautonome" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-links">
      <div>
        <h4>Guides</h4>
        <a href="/categories/preparation">Préparation 72h</a>
        <a href="/categories/equipement">Équipement</a>
        <a href="/categories/habitat">Habitat autonome</a>
        <a href="/categories/sante">Santé & Premiers secours</a>
        <a href="/categories/securite">Sécurité</a>
      </div>
      <div>
        <h4>Le Refuge</h4>
        <a href="/boutique">Boutique</a>
        <a href="/newsletter">Newsletter</a>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <h4>Infos</h4>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-de-confidentialite">Confidentialité</a>
        <a href="/affiliations">Affiliations</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Le Refuge Autonome — Tous droits réservés</p>
      <p class="footer-disclaimer">Certains liens sont affiliés. Cela ne change pas votre prix et nous aide à maintenir ce site gratuitement.</p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  margin-top: 6rem;
  border-top: 1px solid var(--border-subtle);
  background: var(--bg-secondary);
}
.footer-inner {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 4rem;
  padding: 4rem 1.5rem;
}
.footer-logo {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 900;
  color: var(--text-primary);
  text-decoration: none;
  display: block;
  margin-bottom: 0.75rem;
}
.footer-brand p {
  color: var(--text-secondary);
  font-size: 0.875rem;
  line-height: 1.6;
}
.footer-social {
  display: flex;
  gap: 1rem;
  margin-top: 1.25rem;
}
.footer-social a {
  color: var(--text-muted);
  transition: color 0.2s;
}
.footer-social a:hover { color: var(--accent); }
.footer-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.footer-links h4 {
  font-family: var(--font-sub);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}
.footer-links a {
  display: block;
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-decoration: none;
  margin-bottom: 0.5rem;
  transition: color 0.15s;
}
.footer-links a:hover { color: var(--text-primary); }
.footer-bottom {
  border-top: 1px solid var(--border-subtle);
  padding: 1.25rem 0;
}
.footer-bottom .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.footer-bottom p {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-family: var(--font-sub);
}
.footer-disclaimer { font-style: italic; }
@media (max-width: 768px) {
  .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
  .footer-links { grid-template-columns: repeat(2, 1fr); }
  .footer-bottom .container { flex-direction: column; text-align: center; }
}
</style>
