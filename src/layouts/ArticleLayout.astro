---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  readingTime?: number;
}

const { title, description, pubDate, category, tags, readingTime } = Astro.props;

const categoryLabels: Record<string, string> = {
  preparation: 'Préparation',
  equipement: 'Équipement',
  habitat: 'Habitat',
  sante: 'Santé',
  securite: 'Sécurité',
};

const formattedDate = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---
<BaseLayout title={title} description={description}>
  <Header />

  <main class="article-page">
    <div class="article-hero">
      <div class="container--narrow">
        <div class="article-meta-top">
          <a href={`/categories/${category}`} class={`category-badge category-badge--${category}`}>
            {categoryLabels[category] || category}
          </a>
          {readingTime && <span class="reading-time">{readingTime} min de lecture</span>}
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-byline">
          <span class="article-date">{formattedDate}</span>
          {tags && tags.length > 0 && (
            <div class="article-tags">
              {tags.map(tag => <span class="tag">#{tag}</span>)}
            </div>
          )}
        </div>
      </div>
    </div>

    <div class="container--narrow article-body">
      <div class="prose">
        <slot />
      </div>

      <div class="article-cta">
        <p class="label">Rejoindre la communauté</p>
        <h3>Recevoir nos guides chaque semaine</h3>
        <p>Des conseils pratiques, des retours terrain, les meilleures ressources — directement dans votre boîte mail.</p>
        <a href="/newsletter" class="btn btn--primary">Rejoindre le Refuge →</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
.article-page { padding-bottom: 4rem; }
.article-hero {
  padding: 3rem 0 2.5rem;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 2.5rem;
}
.article-meta-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.reading-time {
  font-family: var(--font-sub);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.article-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 1rem;
}
.article-description {
  font-size: 1.1rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}
.article-byline {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}
.article-date {
  font-family: var(--font-sub);
  font-size: 0.75rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}
.article-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.tag {
  font-family: var(--font-sub);
  font-size: 0.7rem;
  color: var(--text-muted);
  background: var(--bg-card);
  padding: 0.2rem 0.6rem;
  border-radius: 2px;
}
.article-body { padding-top: 0; }
.article-cta {
  margin-top: 4rem;
  padding: 2.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  text-align: center;
}
.article-cta h3 {
  font-size: 1.5rem;
  margin: 0.5rem 0 0.75rem;
}
.article-cta p {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  max-width: 450px;
  margin-left: auto;
  margin-right: auto;
}
</style>
