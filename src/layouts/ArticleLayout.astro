---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface ArticleData {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  readingTime?: number;
  image?: string;
  id?: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  readingTime?: number;
  image?: string;
  slug?: string;
  allArticles?: Array<{ id: string; data: ArticleData }>;
}

const { title, description, pubDate, category, tags, readingTime, image, slug, allArticles = [] } = Astro.props;

const categoryLabels: Record<string, string> = {
  preparation: 'Préparation',
  equipement: 'Équipement',
  habitat: 'Habitat',
  sante: 'Santé',
  securite: 'Sécurité',
};

const formattedDate = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric'
});

// Sidebar: 6 other articles (same category first, then rest)
const otherArticles = allArticles
  .filter(a => a.id !== slug)
  .sort((a, b) => {
    if (a.data.category === category && b.data.category !== category) return -1;
    if (b.data.category === category && a.data.category !== category) return 1;
    return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
  })
  .slice(0, 7);

// Related: 3 articles same category at bottom
const relatedArticles = allArticles
  .filter(a => a.id !== slug && a.data.category === category)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---
<BaseLayout title={title} description={description}>
  <Header />

  <main class="article-page">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep">›</span>
          <a href={`/categories/${category}`}>{categoryLabels[category] || category}</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">{title}</span>
        </nav>
      </div>
    </div>

    <div class="container article-layout">
      <!-- Left Sidebar -->
      <aside class="article-sidebar">
        <div class="sidebar-sticky">
          <div class="sidebar-section">
            <h3 class="sidebar-title">Autres articles</h3>
            <ul class="sidebar-articles">
              {otherArticles.map(a => (
                <li class="sidebar-article">
                  <a href={`/blog/${a.id}`} class="sidebar-article-link">
                    {a.data.image && (
                      <img
                        src={a.data.image}
                        alt={a.data.title}
                        class="sidebar-article-img"
                        loading="lazy"
                      />
                    )}
                    {!a.data.image && (
                      <div class="sidebar-article-img sidebar-article-img--placeholder">
                        {categoryLabels[a.data.category]?.charAt(0) || '📋'}
                      </div>
                    )}
                    <div class="sidebar-article-info">
                      <span class={`sidebar-cat sidebar-cat--${a.data.category}`}>
                        {categoryLabels[a.data.category] || a.data.category}
                      </span>
                      <span class="sidebar-article-title">{a.data.title}</span>
                      {a.data.readingTime && (
                        <span class="sidebar-reading-time">{a.data.readingTime} min</span>
                      )}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Newsletter CTA in sidebar -->
          <div class="sidebar-newsletter">
            <p class="sidebar-newsletter-label">Newsletter</p>
            <p class="sidebar-newsletter-text">Guides pratiques chaque semaine</p>
            <a href="/newsletter" class="sidebar-newsletter-btn">S'inscrire gratuitement →</a>
          </div>
        </div>
      </aside>

      <!-- Main Article Content -->
      <article class="article-main">
        <!-- Article Header -->
        <header class="article-header">
          <div class="article-meta-top">
            <a href={`/categories/${category}`} class={`category-badge category-badge--${category}`}>
              {categoryLabels[category] || category}
            </a>
            {readingTime && <span class="reading-time">{readingTime} min de lecture</span>}
          </div>

          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>

          <div class="article-byline">
            <div class="article-author">
              <div class="author-avatar">RA</div>
              <div>
                <span class="author-name">Le Refuge Autonome</span>
                <span class="article-date">{formattedDate}</span>
              </div>
            </div>
            {tags && tags.length > 0 && (
              <div class="article-tags">
                {tags.map(tag => <span class="tag">#{tag}</span>)}
              </div>
            )}
          </div>
        </header>

        {image && (
          <div class="article-hero-image-wrap">
            <img src={image} alt={title} class="article-hero-image" loading="eager" />
          </div>
        )}

        <!-- Article Body -->
        <div class="prose">
          <slot />
        </div>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <section class="related-articles">
            <h2 class="related-title">Articles de la même catégorie</h2>
            <div class="related-grid">
              {relatedArticles.map(a => (
                <a href={`/blog/${a.id}`} class="related-card">
                  {a.data.image && (
                    <img
                      src={a.data.image}
                      alt={a.data.title}
                      class="related-card-img"
                      loading="lazy"
                    />
                  )}
                  <div class="related-card-body">
                    <span class={`category-badge category-badge--${a.data.category}`}>
                      {categoryLabels[a.data.category] || a.data.category}
                    </span>
                    <h3 class="related-card-title">{a.data.title}</h3>
                    <p class="related-card-desc">{a.data.description}</p>
                    {a.data.readingTime && (
                      <span class="related-reading-time">{a.data.readingTime} min de lecture</span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Newsletter CTA -->
        <div class="article-cta">
          <p class="label">Rejoindre la communauté</p>
          <h3>Recevoir nos guides chaque semaine</h3>
          <p>Des conseils pratiques, des retours terrain, les meilleures ressources — directement dans votre boîte mail.</p>
          <a href="/newsletter" class="btn btn--primary">Rejoindre le Refuge →</a>
        </div>
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
/* ── Layout ────────────────────────────────────────── */
.article-page { padding-bottom: 5rem; }

.article-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 3rem;
  align-items: start;
  padding-top: 2rem;
}

/* ── Breadcrumb ────────────────────────────────────── */
.breadcrumb-bar {
  border-bottom: 1px solid var(--border-subtle);
  padding: 0.75rem 0;
  margin-bottom: 0;
  background: var(--bg-primary);
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-sub);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
  flex-wrap: wrap;
}
.breadcrumb a {
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.15s;
}
.breadcrumb a:hover { color: var(--accent); }
.breadcrumb-sep { color: var(--border); }
.breadcrumb-current {
  color: var(--text-secondary);
  max-width: 400px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Sidebar ───────────────────────────────────────── */
.article-sidebar {
  min-width: 0;
}
.sidebar-sticky {
  position: sticky;
  top: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.sidebar-section {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  overflow: hidden;
}
.sidebar-title {
  font-family: var(--font-sub);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: 0.9rem 1rem 0.5rem;
  border-bottom: 1px solid var(--border-subtle);
  margin: 0;
}
.sidebar-articles {
  list-style: none;
  margin: 0;
  padding: 0;
}
.sidebar-article {
  border-bottom: 1px solid var(--border-subtle);
}
.sidebar-article:last-child { border-bottom: none; }

.sidebar-article-link {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  padding: 0.75rem 1rem;
  text-decoration: none;
  transition: background 0.15s;
}
.sidebar-article-link:hover { background: rgba(255,255,255,0.04); }

.sidebar-article-img {
  width: 56px;
  height: 44px;
  object-fit: cover;
  border-radius: 2px;
  flex-shrink: 0;
}
.sidebar-article-img--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  font-size: 1.1rem;
  color: var(--text-muted);
}
.sidebar-article-info {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  min-width: 0;
}
.sidebar-cat {
  font-family: var(--font-sub);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.sidebar-cat--preparation { color: #2d9e6b; }
.sidebar-cat--equipement { color: #e07b39; }
.sidebar-cat--habitat { color: #5d9ecf; }
.sidebar-cat--sante { color: #c96b8a; }
.sidebar-cat--securite { color: #b0a060; }

.sidebar-article-title {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sidebar-reading-time {
  font-family: var(--font-sub);
  font-size: 0.62rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

/* Sidebar Newsletter */
.sidebar-newsletter {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  padding: 1.25rem;
  text-align: center;
}
.sidebar-newsletter-label {
  font-family: var(--font-sub);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 0.4rem;
}
.sidebar-newsletter-text {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin: 0 0 1rem;
  line-height: 1.4;
}
.sidebar-newsletter-btn {
  display: inline-block;
  padding: 0.55rem 1.1rem;
  background: var(--accent);
  color: #000;
  font-family: var(--font-sub);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 2px;
  transition: opacity 0.15s;
}
.sidebar-newsletter-btn:hover { opacity: 0.85; }

/* ── Article Main ──────────────────────────────────── */
.article-main { min-width: 0; }

.article-header {
  margin-bottom: 2rem;
}
.article-meta-top {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.reading-time {
  font-family: var(--font-sub);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.article-title {
  font-size: clamp(1.7rem, 3.5vw, 2.5rem);
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 1rem;
}
.article-description {
  font-size: 1.1rem;
  color: var(--text-secondary);
  line-height: 1.65;
  margin-bottom: 1.5rem;
}
.article-byline {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-subtle);
}
.article-author {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.author-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--accent);
  color: #000;
  font-family: var(--font-sub);
  font-size: 0.7rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.author-name {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
}
.article-date {
  display: block;
  font-family: var(--font-sub);
  font-size: 0.72rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}
.article-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.tag {
  font-family: var(--font-sub);
  font-size: 0.68rem;
  color: var(--text-muted);
  background: var(--bg-card);
  padding: 0.2rem 0.6rem;
  border-radius: 2px;
  border: 1px solid var(--border-subtle);
}

/* Hero image */
.article-hero-image-wrap {
  margin-bottom: 2.5rem;
  border-radius: 4px;
  overflow: hidden;
}
.article-hero-image {
  width: 100%;
  max-height: 480px;
  object-fit: cover;
  display: block;
}

/* ── Prose ─────────────────────────────────────────── */
.prose {
  color: var(--text-primary);
  font-size: 1.05rem;
  line-height: 1.8;
}
.prose :global(h2) {
  font-size: 1.6rem;
  font-weight: 800;
  margin: 2.5rem 0 1rem;
  padding-top: 0.5rem;
  border-top: 2px solid var(--accent);
  display: inline-block;
}
.prose :global(h3) {
  font-size: 1.2rem;
  font-weight: 700;
  margin: 2rem 0 0.75rem;
  color: var(--text-primary);
}
.prose :global(p) { margin-bottom: 1.4rem; }
.prose :global(ul), .prose :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1.4rem;
}
.prose :global(li) { margin-bottom: 0.5rem; }
.prose :global(strong) { color: var(--text-primary); font-weight: 700; }
.prose :global(a) {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.prose :global(a:hover) { opacity: 0.8; }
.prose :global(blockquote) {
  border-left: 3px solid var(--accent);
  padding: 0.75rem 1.25rem;
  margin: 1.5rem 0;
  background: var(--bg-card);
  border-radius: 0 4px 4px 0;
  font-style: italic;
  color: var(--text-secondary);
}
.prose :global(code) {
  background: var(--bg-card);
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  font-size: 0.9em;
  color: var(--accent);
}
.prose :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1.5rem;
  font-size: 0.9rem;
}
.prose :global(th), .prose :global(td) {
  padding: 0.6rem 1rem;
  border: 1px solid var(--border-subtle);
  text-align: left;
}
.prose :global(th) {
  background: var(--bg-card);
  font-weight: 700;
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* ── Related Articles ──────────────────────────────── */
.related-articles {
  margin-top: 4rem;
  padding-top: 3rem;
  border-top: 1px solid var(--border-subtle);
}
.related-title {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 1.5rem;
}
.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.related-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  overflow: hidden;
  text-decoration: none;
  transition: border-color 0.2s, transform 0.2s;
}
.related-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}
.related-card-img {
  width: 100%;
  height: 140px;
  object-fit: cover;
}
.related-card-body {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  flex: 1;
}
.related-card-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
  margin: 0.25rem 0;
}
.related-card-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}
.related-reading-time {
  font-family: var(--font-sub);
  font-size: 0.68rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

/* ── Newsletter CTA ────────────────────────────────── */
.article-cta {
  margin-top: 3.5rem;
  padding: 2.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  text-align: center;
}
.article-cta h3 {
  font-size: 1.5rem;
  margin: 0.5rem 0 0.75rem;
}
.article-cta p {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  max-width: 450px;
  margin-left: auto;
  margin-right: auto;
}

/* ── Responsive ────────────────────────────────────── */
@media (max-width: 1024px) {
  .article-layout {
    grid-template-columns: 240px 1fr;
    gap: 2rem;
  }
}

@media (max-width: 768px) {
  .article-layout {
    grid-template-columns: 1fr;
  }
  .article-sidebar {
    order: 2;
  }
  .article-main {
    order: 1;
  }
  .sidebar-sticky {
    position: static;
  }
  .related-grid {
    grid-template-columns: 1fr;
  }
}
</style>
